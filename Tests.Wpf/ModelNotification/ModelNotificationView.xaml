<UserControl x:Class="Tests.Wpf.ModelNotification.ModelNotificationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tests.Wpf.ModelNotification"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=local:ModelNotificationViewModel}"
             d:DesignHeight="800"
             d:DesignWidth="900"
             Foreground="#222222"
             mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Margin="10" Background="Transparent">

            <!--  说明  -->
            <GroupBox Header="三层嵌套聚合：StepVm → ActionVm → OptionVm（无代理属性，View 直绑 Model 深链路）" Margin="0,0,0,10">
                <TextBlock TextWrapping="Wrap" Foreground="#333333" LineHeight="22">
                    VM 不含代理属性，View 直接绑定 Model 深链路（Step.Model.Name、Step.OptionModel.Value 等）。
                    顶层 <Run FontWeight="Bold" Foreground="#1F4E79">Step.Summary</Run>
                    依赖跨越三层的属性（StepModel + ActionModel + OptionModel）。
                    <LineBreak/>
                    • 编辑任一层的 TextBox/CheckBox → 直接写回 Model，同时 ModelBinder 跨层转发派生刷新；
                    <LineBreak/>
                    • <Run Foreground="#1F4E79" FontWeight="Bold">核心机制</Run>
                    <Run Foreground="#333333">：每层 VM 用 ForwardDerived 订阅下层 </Run>
                    <Run Foreground="#922B21" FontWeight="Bold">Model</Run>
                    <Run Foreground="#333333">（而非下层 VM）的 PropertyChanged，全链路订阅 Model，VM 之间无依赖。</Run>
                    <LineBreak/>
                    • 点 "Replace Step/Action/Option" / "Modify from background" —— 验证多层实例替换的订阅迁移。
                </TextBlock>
            </GroupBox>

            <!-- ============================================================ -->
            <!--  Step 层（顶层）                                              -->
            <!-- ============================================================ -->
            <GroupBox Header="① Step 层（顶层）— {Binding Step.Model.Name} / Step.Summary"
                       Margin="0,0,0,10">
                <StackPanel>
                    <!--  Step Model 直绑  -->
                    <Label Content="Step Name"/>
                    <TextBox Margin="0,0,0,8" Text="{Binding Step.Model.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Step Enabled"/>
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding Step.Model.Enabled, Mode=TwoWay}"/>

                    <!--  顶层聚合派生 Summary  -->
                    <TextBlock Margin="0,8,0,8"
                               Foreground="#922B21"
                               FontSize="14"
                               FontWeight="Bold"
                               Text="{Binding Step.Summary, StringFormat='Step.Summary (三层聚合): {0}'}"
                               TextWrapping="Wrap"/>

                    <!--  HashCode 标识  -->
                    <TextBlock Foreground="#666666">
                        <Run Text="{Binding Step.StepId, StringFormat='Step HashCode: {0}   ', Mode=OneWay}"/>
                        <Run Text="{Binding Step.ActionId, StringFormat='Action HashCode: {0}   ', Mode=OneWay}"/>
                        <Run Text="{Binding Step.OptionId, StringFormat='Option HashCode: {0}', Mode=OneWay}"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- ============================================================ -->
            <!--  Action 层（中层）                                            -->
            <!-- ============================================================ -->
            <GroupBox Header="② Action 层（中层）— {Binding Step.ActionModel.Name}"
                       Margin="0,0,0,10"
                       DataContext="{Binding Step}">
                <StackPanel>
                    <!--  Action Model 直绑  -->
                    <Label Content="Action Name"/>
                    <TextBox Margin="0,0,0,8" Text="{Binding ActionModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Action Enabled"/>
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding ActionModel.Enabled, Mode=TwoWay}"/>
                    <Label Content="Delay (ms)"/>
                    <TextBox Margin="0,0,0,8" Text="{Binding ActionModel.DelayMs, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>

                    <TextBlock Margin="0,8,0,8"
                               Foreground="#1B5E20"
                               TextWrapping="Wrap">
                        <Run Text="编辑这里任一属性，直接写回 ActionModel；StepVm 通过 ForwardDerived 监听到 → Step.Summary 刷新。"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- ============================================================ -->
            <!--  Option 层（最内层）                                          -->
            <!-- ============================================================ -->
            <GroupBox Header="③ Option 层（最内层）— {Binding Step.OptionModel.Value}"
                       Margin="0,0,0,10"
                       DataContext="{Binding Step}">
                <StackPanel>
                    <!--  Option Model 直绑  -->
                    <Label Content="Option Name"/>
                    <TextBox Margin="0,0,0,8" Text="{Binding OptionModel.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Option Value"/>
                    <TextBox Margin="0,0,0,8" Text="{Binding OptionModel.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    <Label Content="Option Enabled"/>
                    <CheckBox Margin="0,0,0,8" IsChecked="{Binding OptionModel.Enabled, Mode=TwoWay}"/>

                    <TextBlock Margin="0,4,0,0"
                               Foreground="#1B5E20"
                               TextWrapping="Wrap">
                        <Run Foreground="#1B5E20">编辑这里任一属性，直接写回 OptionModel，同时跨层转发：</Run>
                        <LineBreak/>
                        <Run Foreground="#666666">OptionModel.Name 变 → ActionVm.ForwardDerived 监听到 → ActionVm.Summary 刷新 → StepVm.ForwardDerived 监听到 → StepVm.Summary 刷新</Run>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

            <!-- ============================================================ -->
            <!--  操作区                                                      -->
            <!-- ============================================================ -->
            <GroupBox Header="操作（验证订阅迁移与跨层通知）" Margin="0,0,0,10"
                       DataContext="{Binding Step}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Command="{Binding ReplaceStepCommand}" Content="Replace Step" Margin="0,0,10,0"/>
                        <Button Command="{Binding ReplaceActionCommand}" Content="Replace Action" Margin="0,0,10,0"/>
                        <Button Command="{Binding ModifyFromBackgroundCommand}" Content="Modify Option.Value from background"/>
                    </StackPanel>
                    <TextBlock Foreground="#666666" TextWrapping="Wrap">
                        <Run Text="Replace Step：整个三层重建（Step/Action/Option Model 全部替换，订阅自动迁移）；"/>
                        <LineBreak/>
                        <Run Text="Modify from background：后台线程改 OptionModel.Value，验证三层 Summary 都刷新。"/>
                    </TextBlock>
                </StackPanel>
            </GroupBox>

        </StackPanel>
    </ScrollViewer>
</UserControl>
