<UserControl x:Class="Tests.Wpf.StatePattern.StatePatternView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="620"
             d:DesignWidth="760"
             mc:Ignorable="d">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"
                           MinHeight="140" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!--
            Top half: the data grid. Selecting a row delegates "SelectionChanged" to the current
            state via SelectedRow -> StateEditorContext.OnSelectedRowChanged.
            上半部分：数据表格。选中一行时经 SelectedRow -> StateEditorContext.OnSelectedRowChanged
            把 SelectionChanged 输入委托给当前状态。
        -->
        <DataGrid Grid.Row="0"
                  IsReadOnly="True"
                  ItemsSource="{Binding Context.Rows}"
                  SelectedItem="{Binding Context.SelectedRow, Mode=TwoWay}" />

        <GroupBox Grid.Row="1"
                  Margin="0,8,0,0"
                  Header="Editor panel">
            <StackPanel Margin="5">
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="Bold"
                               Text="State: " />
                    <TextBlock VerticalAlignment="Center"
                               MinWidth="64"
                               Text="{Binding Context.StateName}" />
                    <!-- The Add button changes label and meaning per state: Add / Save. -->
                    <!-- Add 按钮随状态改变文字与含义：Add / Save。 -->
                    <Button Width="72"
                            Margin="16,0,0,0"
                            Command="{Binding Context.AddCommand}"
                            Content="{Binding Context.AddButtonLabel}"
                            IsEnabled="{Binding Context.AddEnabled}" />
                    <Button Width="72"
                            Margin="8,0,0,0"
                            Command="{Binding Context.UpdateCommand}"
                            Content="Update"
                            IsEnabled="{Binding Context.UpdateEnabled}" />
                    <Button Width="72"
                            Margin="8,0,0,0"
                            Command="{Binding Context.DeleteCommand}"
                            Content="Delete"
                            IsEnabled="{Binding Context.DeleteEnabled}" />
                </StackPanel>

                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               VerticalAlignment="Center"
                               Text="Name:" />
                    <TextBox Grid.Column="1"
                             Margin="4,0,12,0"
                             Text="{Binding Context.EditorName, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2"
                               VerticalAlignment="Center"
                               Text="Category:" />
                    <TextBox Grid.Column="3"
                             Margin="4,0,12,0"
                             Text="{Binding Context.EditorCategory, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="4"
                               VerticalAlignment="Center"
                               Text="Price:" />
                    <TextBox Grid.Column="5"
                             Margin="4,0,0,0"
                             Text="{Binding Context.EditorPrice, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="2"
                   Margin="0,6,0,0"
                   Foreground="Gray"
                   Text="{Binding Context.StatusText}" />

        <Expander Grid.Row="3"
                  Margin="0,8,0,0"
                  Header="Design notes - State pattern (refactoringguru.cn/design-patterns/state)">
            <StackPanel Margin="5">
                <TextBlock FontWeight="Bold" Text="Roles / 角色映射" />
                <TextBlock TextWrapping="Wrap"
                           Text="• Context = StateEditorContext：持有 CurrentState，把 Add/Update/Delete 点击与行选中变化原样委托给当前状态；状态通过 ChangeState() 自行切换，Context 与按钮事件里没有任何 if/else 模式判断。" />
                <TextBlock TextWrapping="Wrap"
                           Text="• State = IEditorState：定义统一输入接口 AddClicked / UpdateClicked / DeleteClicked / SelectionChanged，外加 OnEnter() 在进入状态时同步按钮可用性与编辑区内容。" />
                <TextBlock TextWrapping="Wrap"
                           Text="• ConcreteState：IdleState（未选中：仅 Add 可用）、AddingState（新增草稿：Add 按钮变为 Save）、UpdatingState（编辑选中行：Update/Delete 可用）。三者只实现操作、不持有独立变量，需要时手动 new，用完即弃。" />

                <TextBlock Margin="0,8,0,0"
                           FontWeight="Bold"
                           Text="Transitions / 状态转移" />
                <TextBlock TextWrapping="Wrap"
                           Text="• Idle ──Add──▶ Adding ──Save──▶ Updating（保存新行并选中它）" />
                <TextBlock TextWrapping="Wrap"
                           Text="• Idle ──选中一行──▶ Updating（编辑区载入该行）" />
                <TextBlock TextWrapping="Wrap"
                           Text="• Updating ──Add──▶ Adding（清空面板）；──Update──▶ Updating（草稿写回选中行）；──Delete──▶ Idle（删除行并清除选中）" />
                <TextBlock TextWrapping="Wrap"
                           Text="• Adding ──选中一行──▶ Updating；选中被清空 ──▶ Idle" />

                <TextBlock Margin="0,8,0,0"
                           FontWeight="Bold"
                           Text="Why / 设计收益" />
                <TextBlock TextWrapping="Wrap"
                           Text="• 同一个 Add 按钮在三个状态中含义不同（进入新增 / 保存新行），Update 与 Delete 仅在 Updating 可用——这些差异完全封装在各状态类中，事件处理代码统一为一句 CurrentState.XxxClicked(this)。" />
                <TextBlock TextWrapping="Wrap"
                           Text="• 相比在一个方法里堆 isAdding / selectedRow != null 之类的条件分支，状态模式把每个模式的行为局部化到独立类，新增一种模式（如只读浏览）只需增加一个 IEditorState 实现。" />
                <TextBlock TextWrapping="Wrap"
                           Text="• 编辑区使用独立草稿字段，Update 提交时才写回行对象；行模型带 INPC，DataGrid 随提交自动刷新，面板与表格不会出现“未确认的半编辑状态”。" />
            </StackPanel>
        </Expander>
    </Grid>
</UserControl>
