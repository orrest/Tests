<UserControl x:Class="Tests.Wpf.InPageNavigation.InPageNavigationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tests.Wpf.InPageNavigation"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="220"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Floating table of contents on the left. -->
        <!-- 左侧悬浮目录 -->
        <Border Grid.Column="0"
                Background="#F5F5F5"
                BorderBrush="LightGray"
                BorderThickness="0,0,1,0">
            <StackPanel Margin="10">
                <TextBlock Margin="0,0,0,8"
                           FontWeight="Bold"
                           Text="Catalog"/>

                <!-- Each button's Tag stores the target element's x:Name. -->
                <!-- 每个按钮的 Tag 存储目标元素的 x:Name -->
                <Button Margin="0,0,0,4"
                        Click="NavButton_Click"
                        Content="1. Basic info"
                        Tag="GroupBasic"/>
                <Button Margin="0,0,0,4"
                        Click="NavButton_Click"
                        Content="2. Appearance"
                        Tag="GroupAppearance"/>
                <Button Margin="0,0,0,4"
                        Click="NavButton_Click"
                        Content="3. Input"
                        Tag="GroupInput"/>
                <Button Margin="0,0,0,4"
                        Click="NavButton_Click"
                        Content="4. Layout"
                        Tag="GroupLayout"/>
                <Button Margin="0,0,0,4"
                        Click="NavButton_Click"
                        Content="5. Advanced"
                        Tag="GroupAdvanced"/>

                <TextBlock Margin="0,12,0,0"
                           FontStyle="Italic"
                           Text="Demo: top-aligned scroll via ScrollToVerticalOffset"
                           TextWrapping="Wrap"/>
            </StackPanel>
        </Border>

        <!-- Scrollable content on the right. -->
        <!-- 右侧可滚动内容 -->
        <ScrollViewer x:Name="ContentScroll"
                      Grid.Column="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">
                <StackPanel.Resources>
                    <Style TargetType="GroupBox">
                        <Setter Property="MinHeight"
                                Value="300"/>
                    </Style>
                </StackPanel.Resources>
                <GroupBox x:Name="GroupBasic"
                        Header="1. Basic info">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Target of catalog item #1."/>
                        <LineBreak/>
                        <Run Text="This GroupBox is reached by calling target.BringIntoView()."/>
                    </TextBlock>
                </GroupBox>

                <GroupBox x:Name="GroupAppearance"
                          Margin="0,12,0,0"
                          Header="2. Appearance">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Target of catalog item #2."/>
                        <LineBreak/>
                        <Run Text="BringIntoView raises a bubbling RequestBringIntoView event handled by the parent ScrollViewer."/>
                    </TextBlock>
                </GroupBox>

                <GroupBox x:Name="GroupInput"
                          Margin="0,12,0,0"
                          Header="3. Input">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Target of catalog item #3."/>
                        <LineBreak/>
                        <Run Text="The target element must have an x:Name so FindName can resolve it."/>
                    </TextBlock>
                </GroupBox>

                <GroupBox x:Name="GroupLayout"
                          Margin="0,12,0,0"
                          Header="4. Layout">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Target of catalog item #4."/>
                        <LineBreak/>
                        <Run Text="The target must live inside a ScrollViewer; otherwise the call is a no-op."/>
                    </TextBlock>
                </GroupBox>

                <GroupBox x:Name="GroupAdvanced"
                          Margin="0,12,0,0"
                          Header="5. Advanced">
                    <TextBlock TextWrapping="Wrap">
                        <Run Text="Target of catalog item #5."/>
                        <LineBreak/>
                        <Run Text="For smooth scrolling, use ScrollAnimationBehavior with ScrollToVerticalOffset (out of scope for this minimal demo)."/>
                    </TextBlock>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
