<UserControl x:Class="Tests.Wpf.Validations.ValidationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tests.Wpf.Validations"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:Tests.Wpf.Models"
             xmlns:rules="clr-namespace:Tests.Wpf.ValidationRules"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <UserControl.Resources>
        <models:Person x:Key="Data" />
        <models:MyDataSource x:Key="Ods" />

        <!--  The tool tip for the TextBox to display the validation error message.  -->
        <Style x:Key="TextBoxInError" TargetType="TextBox">
            <Style.Triggers>
                <Trigger Property="Validation.HasError" Value="true">
                    <Setter Property="ToolTip" Value="{Binding RelativeSource={x:Static RelativeSource.Self}, Path=(Validation.Errors)[0].ErrorContent}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <ControlTemplate x:Key="ValidationTemplate">
            <DockPanel>
                <TextBlock FontSize="20" Foreground="Red">!</TextBlock>
                <AdornedElementPlaceholder />
            </DockPanel>
        </ControlTemplate>
    </UserControl.Resources>

    <ScrollViewer>
        <StackPanel Margin="20">

            <GroupBox Padding="20" Header="Validate on model with IDataErrorInfo interface and DataErrorValidationRule.">
                <StackPanel>
                    <TextBlock>Enter your age:</TextBlock>
                    <TextBox Style="{StaticResource TextBoxInError}">
                        <TextBox.Text>
                            <!--
                    By setting ValidatesOnExceptions to True, it checks for exceptions
                    that are thrown during the update of the source property.
                    An alternative syntax is to add <ExceptionValidationRule/> within
                    the <Binding.ValidationRules> section.
                            -->
                            <Binding Path="Age"
                                     Source="{StaticResource Data}"
                                     UpdateSourceTrigger="PropertyChanged"
                                     ValidatesOnExceptions="True">
                                <Binding.ValidationRules>
                                    <!--
                                        DataErrorValidationRule checks for validation
                                        errors raised by the IDataErrorInfo object.
                                    -->
                                    <!--  Alternatively, you can set ValidationOnDataErrors="True" on the Binding.  -->
                                    <DataErrorValidationRule />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock>Mouse-over to see the validation error message.</TextBlock>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0" Header="TextBox with _custom ErrorTemplate and ToolTip:">
                <StackPanel>
                    <TextBox x:Name="custom"
                             Width="200"
                             Style="{StaticResource TextBoxInError}"
                             Validation.ErrorTemplate="{StaticResource ValidationTemplate}">
                        <TextBox.Text>
                            <Binding Path="Age"
                                     Source="{StaticResource Ods}"
                                     UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <rules:AgeRangeRule Max="130" Min="21" />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0" Header="TextBox with _default ErrorTemplate:">
                <StackPanel>
                    <TextBox Width="200">
                        <TextBox.Text>
                            <Binding Path="Age2"
                                     Source="{StaticResource Ods}"
                                     UpdateSourceTrigger="PropertyChanged">
                                <Binding.ValidationRules>
                                    <rules:AgeRangeRule Max="130" Min="21" />
                                </Binding.ValidationRules>
                            </Binding>
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Padding="10"
                      Header="Validate with INotifyDataErrorInfo 21-100 (business layer)">
                <StackPanel>
                    <TextBlock Text="MinAge" />
                    <TextBox Width="200">
                        <TextBox.Text>
                            <Binding Path="MinAge" UpdateSourceTrigger="PropertyChanged" />
                        </TextBox.Text>
                    </TextBox>
                    <TextBlock Text="Age" />
                    <TextBox Width="200" Style="{StaticResource TextBoxInError}">
                        <TextBox.Text>
                            <Binding Path="Age" UpdateSourceTrigger="PropertyChanged" />
                        </TextBox.Text>
                    </TextBox>
                </StackPanel>
            </GroupBox>

            <GroupBox Margin="0,20,0,0"
                      Padding="10"
                      Header="DataGrid with annotation-based validation and delete action">
                <!--
                    Tag holds the DataGrid's own DataContext (the ViewModel) so the
                    row ContextMenu — which lives outside the visual tree and therefore
                    cannot reach the DataGrid via AncestorType — can still bind to
                    RemoveCommand through PlacementTarget.Tag.
                    用 Tag 缓存 DataGrid 自身的 DataContext（ViewModel），
                    行级 ContextMenu 不在可视化树中、无法用 AncestorType 找到 DataGrid，
                    借助 PlacementTarget.Tag 即可拿到 RemoveCommand。
                -->
                <DataGrid Margin="0,8,0,0"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          ItemsSource="{Binding Items}"
                          MinColumnWidth="80"
                          Tag="{Binding DataContext, RelativeSource={RelativeSource Self}}">
                    <DataGrid.Resources>
                        <!--
                            DataGridTemplateColumn generates an internal ContentPresenter with an empty-path
                            Binding to the row item. When the row item implements INotifyDataErrorInfo, that
                            ContentPresenter's Validation.HasError becomes true and paints the default red
                            ErrorTemplate adorner (a Border filling the cell). Null its ErrorTemplate here.
                            DataGridTemplateColumn 会生成一个内部 ContentPresenter，并绑定空路径 Binding 到行项。
                            行项实现 INotifyDataErrorInfo 时，该 ContentPresenter 的 Validation.HasError 变为 true，
                            画出默认红色 ErrorTemplate adorner（填满 cell 的 Border）。在此置空其 ErrorTemplate。
                            Scope: DataGridTextColumn doesn't use ContentPresenter (it generates TextBlock
                            directly), so this implicit style only affects template columns.
                            作用域：DataGridTextColumn 不使用 ContentPresenter（直接生成 TextBlock），
                            故此隐式样式仅影响模板列。
                        -->
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Validation.ErrorTemplate" Value="{x:Null}" />
                        </Style>
                    </DataGrid.Resources>
                    <!--
                        Row-level context menu for delete.
                        DataGrid 行级右键菜单：复用 RemoveCommand 删除当前行。
                        ContextMenu 不在可视化树中，DataContext 不会自动继承：
                        - PlacementTarget        = 被右键的 DataGridRow
                        - PlacementTarget.Tag    = ViewModel（RemoveCommand 所在）
                        - PlacementTarget.DataContext = 行项 ValidationItem
                    -->
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ContextMenu">
                                <Setter.Value>
                                    <ContextMenu>
                                        <MenuItem Command="{Binding PlacementTarget.Tag.RemoveCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                  Header="Delete Row" />
                                    </ContextMenu>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>

                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                            Header="Name" />

                        <DataGridTextColumn Width="80"
                                            Binding="{Binding Age, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                            Header="Age" />

                        <DataGridTextColumn Width="*"
                                            Binding="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, ValidatesOnNotifyDataErrors=True}"
                                            Header="Email" />

                        <DataGridTemplateColumn Width="100"
                                                Header="Action"
                                                IsReadOnly="True">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <!--
                                        Null the button's own ErrorTemplate: CommandParameter binds to the row
                                        item (INotifyDataErrorInfo), so without this the button would paint its
                                        own red adorner when the row item reports errors.
                                        置空按钮自身的 ErrorTemplate：CommandParameter 绑定到行项（INotifyDataErrorInfo），
                                        否则行项报错时按钮会绘制自己的红色 adorner。
                                    -->
                                    <Button Margin="4"
                                            Padding="8,2"
                                            HorizontalAlignment="Center"
                                            Command="{Binding DataContext.RemoveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                            CommandParameter="{Binding}"
                                            Content="Delete"
                                            Validation.ErrorTemplate="{x:Null}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>

</UserControl>
