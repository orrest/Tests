<UserControl x:Class="Tests.Wpf.Skottie.SkottieView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:Tests.Wpf.Skottie"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
             d:DataContext="{d:DesignInstance Type=local:SkottieViewModel}"
             d:DesignHeight="450"
             d:DesignWidth="800"
             mc:Ignorable="d">
    <DockPanel>
        <WrapPanel DockPanel.Dock="Top"
                   Margin="4">
            <ComboBox Width="170"
                      Height="26"
                      Margin="0,0,8,4"
                      VerticalContentAlignment="Center"
                      DisplayMemberPath="Title"
                      ItemsSource="{Binding Path=Clips}"
                      SelectedItem="{Binding Path=SelectedClip}" />
            <Button MinWidth="92"
                    Margin="0,0,8,4"
                    Command="{Binding Path=PlayPauseCommand}"
                    Content="Play / Pause" />
            <Button MinWidth="56"
                    Margin="0,0,16,4"
                    Command="{Binding Path=StopCommand}"
                    Content="Stop" />
            <CheckBox Margin="0,0,16,4"
                      VerticalAlignment="Center"
                      Content="Loop"
                      IsChecked="{Binding Path=IsLooping}" />
            <TextBlock Margin="0,0,4,4"
                       VerticalAlignment="Center"
                       Text="Speed" />
            <Slider Width="140"
                    Margin="0,0,4,4"
                    VerticalAlignment="Center"
                    IsSnapToTickEnabled="True"
                    Maximum="3"
                    Minimum="0.25"
                    TickFrequency="0.25"
                    Value="{Binding Path=Speed}" />
            <TextBlock Margin="0,0,0,4"
                       VerticalAlignment="Center"
                       Text="{Binding Path=Speed, StringFormat={}{0:0.##}x}" />
        </WrapPanel>

        <TextBlock DockPanel.Dock="Bottom"
                   Margin="8,2,8,4"
                   Foreground="Gray"
                   Text="{Binding Path=InfoText}"
                   TextTrimming="CharacterEllipsis" />

        <DockPanel DockPanel.Dock="Bottom"
                   Margin="8,4">
            <TextBlock x:Name="TimeText"
                       VerticalAlignment="Center"
                       Text="0.00s / 0.00s" />
            <Slider x:Name="SeekSlider"
                    Margin="8,0,0,0"
                    IsMoveToPointEnabled="True"
                    Maximum="100"
                    Minimum="0" />
        </DockPanel>

        <Border Background="#FAFAFA">
            <skia:SKElement x:Name="AnimationHost"
                            PaintSurface="OnAnimationHostPaintSurface" />
        </Border>
    </DockPanel>
</UserControl>
