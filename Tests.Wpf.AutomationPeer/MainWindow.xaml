<Window x:Class="Tests.Wpf.AutomationPeer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="AutomationPeer Memory Retention Demo"
        Width="720"
        Height="480"
        mc:Ignorable="d">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TabControl x:Name="TabRegion" />

        <WrapPanel Grid.Row="1"
                   Margin="0,8,0,0">
            <Button MinWidth="80"
                    Margin="0,0,8,0"
                    Content="Add"
                    Click="OnAddClick" />
            <Button MinWidth="80"
                    Margin="0,0,8,0"
                    Content="Remove"
                    Click="OnRemoveClick" />
            <Button MinWidth="140"
                    Margin="0,0,8,0"
                    Content="Simulate UIA Query"
                    Click="OnSimulateUiaQueryClick" />
            <Button MinWidth="80"
                    Content="GC"
                    Click="OnForceGcClick" />
        </WrapPanel>

        <TextBlock x:Name="StatusText"
                   Grid.Row="2"
                   Margin="0,8,0,0" />
    </Grid>
</Window>
